# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Python tool caches / test artifacts
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv

# Runtime data — ignore contents, keep directory structure (via .gitkeep)
storage/samples/*
storage/uploads/*
storage/models/*
storage/output/*
storage/sandbox/*
storage/*.db
!storage/**/README.md
!storage/**/.gitkeep

# Node / frontend
node_modules/
src/frontend/dist/
tsconfig.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# Docker compose project name (auto-generated by `make env`)
.env
# Local env overrides (Vite reads .env.local / .env.<mode>.local)
.env.local
.env.*.local

# IDE
.idea/
.vscode/

# OS cruft
.DS_Store
._*
Thumbs.db
Desktop.ini

# Playwright MCP
.playwright-mcp/

# Raw data
data/

# Private planning / internal docs
plans/
project/

# Logfire CLI credentials (would enable telemetry sends)
.logfire/
